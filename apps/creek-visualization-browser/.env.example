# Optional. World Imagery and World Elevation load without a key.
# When set, the key is sent with ArcGIS requests and can raise tile quota.
VITE_ARCGIS_API_KEY=

# Optional. Where modeled creek water data comes from: "hosted" or "local".
# hosted = published ArcGIS Enterprise feature services (read-only queries).
# local  = pipeline working output served by the Vite dev server plugin.
# Default: local in the dev server and test mode, hosted in production builds.
VITE_CREEK_DATA_SOURCE=

# Optional. ArcGIS Enterprise portal used for sign-in to private items.
# Default: https://dangermondpreserve-spatial.com/portal
VITE_ARCGIS_PORTAL_URL=

# Optional. Modeled water surface elevation (WSE) FeatureServer URL.
# Default: .../Hosted/creek_water_visualization_modeled_wse/FeatureServer
VITE_MODELED_WSE_SERVICE_URL=

# Optional. WSE polygons FeatureServer URL.
# Default: .../Hosted/creek_water_visualization_wse_polygons/FeatureServer
VITE_WSE_POLYGONS_SERVICE_URL=

# Optional. Observed Creek Gauge Data FeatureServer URL (public).
# Default: .../Dangermond_Creek_Gauges/FeatureServer
VITE_CREEK_GAUGE_SERVICE_URL=

# Optional. "true" shows the California Natural Flows monthly Dataset. Default: false (hidden).
VITE_SHOW_CALIFORNIA_NATURAL_FLOWS_MONTHLY=
