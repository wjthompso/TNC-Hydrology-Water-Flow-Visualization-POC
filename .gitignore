# Generated data folders. No trailing slash on purpose: a trailing slash only
# matches real folders, so a symlink at the same path would not be ignored.
# Modeled water-surface elevation pipeline stage outputs (regenerated by npm run pipeline:modeled-wse:all)
/data/pipeline-working-output
# Old name of the folder above (UCS-295). Keeps older checkouts from showing it as untracked until they migrate; remove once every worktree has moved it (see data/README.md).
/data/modeled-water-surface-elevation-pipeline-output
# Frozen copies of published data-product versions (written by the ArcGIS publishing workflow; see data/README.md)
/data/data-product-versions

# Repository-root environment files. .env.example stays tracked.
/.env
/.env.local

# macOS Finder metadata
.DS_Store
**/.DS_Store

# Live browser test response cache (Esri and USGS 3DEP), filled by live tests
/.test-cache

# Python bytecode caches (written by the ArcGIS publishing scripts)
__pycache__/
*.pyc
TNC-Hydrology-Water-Flow.local.code-workspace
*.code-workspace
